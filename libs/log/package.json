{
  "name": "@neodx/log",
  "version": "1.1.0",
  "description": "A lightweight universal logging framework",
  "keywords": [
    "cli",
    "colorful",
    "console",
    "hackable",
    "isomorphic",
    "json",
    "log",
    "logger",
    "logging",
    "tiny"
  ],
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/log",
  "bugs": "https://github.com/secundant/neodx/issues",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "email": "mysecundant@gmail.com",
    "url": "https://github.com/secundant"
  },
  "contributors": [
    "secundant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/log"
  },
  "source": [
    "src/*/index.ts",
    "src/*.ts"
  ],
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.mts",
          "default": "./dist/node/index.mjs"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "development": "./src/node/index.ts",
      "browser": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "import": {
        "types": "./dist/node/index.d.mts",
        "default": "./dist/node/index.mjs"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./utils": {
      "development": "./src/utils/index.ts",
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "default": "./dist/utils/index.cjs"
      }
    },
    "./express": {
      "development": "./src/express.ts",
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./koa": {
      "development": "./src/koa.ts",
      "import": {
        "types": "./dist/koa.d.mts",
        "default": "./dist/koa.mjs"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    },
    "./http": {
      "development": "./src/http/index.ts",
      "import": {
        "types": "./dist/http/index.d.mts",
        "default": "./dist/http/index.mjs"
      },
      "require": {
        "types": "./dist/http/index.d.cts",
        "default": "./dist/http/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compare-bundle": "tsx bench/compare-bundle.ts",
    "compare-output": "tsx bench/compare-output.ts",
    "show-output": "tsx examples/big-list-of-logs.ts",
    "bench": "vitest bench",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "yarn dlx rimraf dist",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "pack": "vp pack",
    "prepack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --prepack",
    "postpack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --postpack"
  },
  "dependencies": {
    "@neodx/colors": "workspace:^",
    "@neodx/std": "workspace:^",
    "pathe": "1.1.2"
  },
  "devDependencies": {
    "@types/bunyan": "1.8.11",
    "@types/express": "4.17.25",
    "@types/koa": "2.15.2",
    "@types/tmp": "0.2.6",
    "bunyan": "1.8.15",
    "cli-truncate": "4.0.0",
    "express": "4.22.2",
    "koa": "2.16.4",
    "loglevel": "1.9.1",
    "pino": "8.20.0",
    "tmp": "0.2.7",
    "tsx": "4.23.12",
    "winston": "3.13.0"
  },
  "peerDependencies": {
    "@types/express": "*",
    "@types/koa": "*",
    "express": "*",
    "koa": "*"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "@types/koa": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.3.1"
}
