{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@neodx/std": ["../std/src/index.ts"],
      "@neodx/std/*": ["../std/src/*.ts", "../std/src/*/index.ts"],
      "@neodx/colors": ["../colors/src/index.ts"]
    }
  },
  "references": [
    { "path": "../std/tsconfig.refs.json" },
    { "path": "../colors/tsconfig.refs.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/__tests__/**",
    "dist",
    "dist-types",
    "node_modules",
    "examples",
    "bench"
  ]
}
