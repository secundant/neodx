{
  "name": "@neodx/colors",
  "version": "1.0.3",
  "description": "Formatting and color utils for the terminal",
  "keywords": [
    "cli",
    "colors",
    "console",
    "formatting",
    "terminal",
    "utils"
  ],
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/colors",
  "bugs": "https://github.com/secundant/neodx/issues",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "email": "mysecundant@gmail.com",
    "url": "https://github.com/secundant"
  },
  "contributors": [
    "secundant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/colors"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "nuke": "rm -rf dist",
    "pack": "vp pack",
    "prepack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --prepack",
    "postpack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --postpack"
  },
  "dependencies": {
    "@neodx/std": "workspace:^"
  }
}
