{
  "name": "@neodx/fs",
  "version": "0.0.13",
  "description": "File system helpers",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "yarn dlx rimraf dist",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "pack": "vp pack"
  },
  "dependencies": {
    "@neodx/std": "workspace:^",
    "jsonc-parser": "3.2.1",
    "tiny-glob": "0.2.9"
  },
  "devDependencies": {
    "@types/tmp": "0.2.6",
    "tmp": "0.2.3"
  }
}
