{
  "name": "@neodx/glob",
  "version": "1.0.1",
  "description": "Fast glob matching and path walking helpers",
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/glob",
  "bugs": "https://github.com/secundant/neodx/issues",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "email": "mysecundant@gmail.com",
    "url": "https://github.com/secundant"
  },
  "contributors": [
    "secundant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/glob"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json",
    "bench": "vitest bench",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "nuke": "rm -rf dist",
    "pack": "vp pack",
    "prepack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --prepack",
    "postpack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --postpack"
  },
  "dependencies": {
    "@neodx/log": "workspace:^",
    "@neodx/std": "workspace:^"
  },
  "devDependencies": {
    "grammex": "3.1.3"
  },
  "packageManager": "yarn@4.3.1"
}
