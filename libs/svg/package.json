{
  "name": "@neodx/svg",
  "version": "1.0.2",
  "description": "Supercharge your icons ⚡️",
  "keywords": [
    "generator",
    "icons",
    "react",
    "sprite",
    "svg",
    "svgr",
    "typescript"
  ],
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/svg",
  "bugs": "https://github.com/secundant/neodx/issues",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "email": "mysecundant@gmail.com",
    "url": "https://github.com/secundant"
  },
  "contributors": [
    "secundant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/svg"
  },
  "bin": {
    "sprite": "bin.mjs"
  },
  "source": [
    "src/index.ts",
    "src/cli.ts",
    "src/esbuild.ts",
    "src/rollup.ts",
    "src/rspack.ts",
    "src/vite.ts",
    "src/webpack.ts"
  ],
  "files": [
    "package.json",
    "bin.mjs",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    },
    "./esbuild": {
      "development": "./src/esbuild.ts",
      "types": "./dist/esbuild.d.ts",
      "require": "./dist/esbuild.cjs",
      "default": "./dist/esbuild.mjs"
    },
    "./rollup": {
      "development": "./src/rollup.ts",
      "types": "./dist/rollup.d.ts",
      "require": "./dist/rollup.cjs",
      "default": "./dist/rollup.mjs"
    },
    "./rspack": {
      "development": "./src/rspack.ts",
      "types": "./dist/rspack.d.ts",
      "require": "./dist/rspack.cjs",
      "default": "./dist/rspack.mjs"
    },
    "./vite": {
      "development": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "require": "./dist/vite.cjs",
      "default": "./dist/vite.mjs"
    },
    "./webpack": {
      "development": "./src/webpack.ts",
      "types": "./dist/webpack.d.ts",
      "require": "./dist/webpack.cjs",
      "default": "./dist/webpack.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json",
    "bench": "vitest bench",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "pack": "vp pack",
    "prepack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --prepack",
    "postpack": "node ../../tools/scripts/rewrite-workspace-protocol.mjs --postpack"
  },
  "dependencies": {
    "@neodx/fs": "workspace:^",
    "@neodx/glob": "workspace:^",
    "@neodx/log": "workspace:^",
    "@neodx/std": "workspace:^",
    "@neodx/vfs": "workspace:^",
    "chokidar": "3.6.0",
    "colord": "2.9.3",
    "commander": "12.0.0",
    "fast-xml-parser": "4.4.0",
    "jiti": "1.21.6",
    "object-hash": "3.0.0",
    "pathe": "1.1.2",
    "svgo": "3.3.2",
    "ts-pattern": "5.2.0",
    "unplugin": "1.11.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@neodx/internal": "workspace:^",
    "@swc/helpers": "0.5.9",
    "@types/react": "18.2.78",
    "@types/react-dom": "18.2.25",
    "@types/svgo": "3.0.0",
    "clsx": "2.1.0",
    "prettier": "3.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "svgson": "5.3.1"
  },
  "peerDependencies": {
    "prettier": "*"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.3.1"
}
