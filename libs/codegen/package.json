{
  "name": "@neodx/codegen",
  "version": "0.0.7",
  "private": true,
  "description": "Code generation API",
  "keywords": [
    "boilerplate",
    "codegen",
    "generator",
    "neodx",
    "template"
  ],
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/codegen",
  "bugs": {
    "url": "https://github.com/secundant/neodx/issues"
  },
  "license": "MIT",
  "author": "Dmitry Remezov",
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/codegen"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "add-example": "node scripts/add-example.mjs",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vp test",
    "lint": "vp lint"
  },
  "dependencies": {
    "@neodx/fs": "workspace:^",
    "@neodx/pkg-misc": "workspace:^",
    "@neodx/std": "workspace:^",
    "@neodx/vfs": "workspace:^",
    "ejs": "3.1.10",
    "jsonc-parser": "3.2.1",
    "picocolors": "1.0.0",
    "prettier": "3.3.2",
    "semver": "7.6.0"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/semver": "7.5.8",
    "@types/tmp": "0.2.6",
    "tmp": "0.2.3"
  },
  "packageManager": "yarn@4.3.1"
}
