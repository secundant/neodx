{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/__tests__/**",
    "dist",
    "dist-types",
    "node_modules",
    "examples",
    "bench",
    "docs",
    "test",
    "tests"
  ]
}
