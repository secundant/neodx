{
  "name": "@neodx/root",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/secundant/neodx",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "url": "https://github.com/secundant"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx"
  },
  "workspaces": [
    "apps/*",
    "apps/examples/svg/*",
    "apps/e2e/*",
    "apps/examples/*",
    "libs/*",
    "tools/*",
    "tools/scripts/templates/*"
  ],
  "scripts": {
    "clean-node_modules": "yarn dlx rimraf '**/node_modules'",
    "check-install": "yarn dlx @yarnpkg/doctor .",
    "prepare": "is-ci || vp config --no-agent",
    "release-version": "yarn changeset version && yarn install --mode=update-lockfile",
    "release-publish": "yarn pack:libs && yarn verify-packed-manifest && yarn verify-publish-manifest && node tools/scripts/publish-with-rewritten-workspace.mjs",
    "check": "vp check",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "verify-exports": "node tools/scripts/verify-exports.mjs",
    "publint": "node tools/scripts/publint-libs.mjs",
    "attw": "node tools/scripts/attw-libs.mjs",
    "verify-packed-manifest": "node tools/scripts/verify-packed-manifest.mjs",
    "verify-publish-manifest": "node tools/scripts/verify-publish-manifest.mjs",
    "check-references": "node tools/scripts/check-references.mjs --check",
    "depcruise": "depcruise \"libs/*/src/**/*.{ts,tsx}\" --output-type err --ignore-known",
    "depcruise:baseline": "depcruise \"libs/*/src/**/*.{ts,tsx}\" --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "typecheck": "tsc -b",
    "pack:libs": "vp run --filter \"./libs/*\" --filter \"!@neodx/autobuild\" --filter \"!@neodx/codegen\" --filter \"!@neodx/internal\" pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.5.0",
    "@changesets/cli": "2.27.1",
    "@commitlint/cli": "19.2.2",
    "@commitlint/config-conventional": "19.2.2",
    "@neodx/scripts": "workspace:^",
    "@types/node": "20.19.43",
    "dependency-cruiser": "18.1.1",
    "eslint": "8.57.0",
    "is-ci": "3.0.1",
    "micromatch": "4.0.5",
    "picomatch": "4.0.2",
    "prettier": "3.3.2",
    "publint": "0.3.12",
    "tsx": "4.23.12",
    "type-fest": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vite-plus": "0.2.7",
    "vitest": "4.1.10",
    "zeptomatch": "2.0.0"
  },
  "dependenciesMeta": {
    "core-js": {
      "built": false
    },
    "core-js-pure": {
      "built": false
    }
  },
  "resolutions": {
    "express": "4.22.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.3.1"
}
