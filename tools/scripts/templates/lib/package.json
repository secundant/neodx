{
  "name": "@neodx/<%=name%>",
  "version": "0.0.1",
  "private": true,
  "description": "No description",
  "homepage": "https://github.com/secundant/neodx/tree/main/libs/<%=name%>",
  "bugs": "https://github.com/secundant/neodx/issues",
  "license": "MIT",
  "author": {
    "name": "Dmitry Remezov",
    "email": "mysecundant@gmail.com",
    "url": "https://github.com/secundant"
  },
  "contributors": [
    "secundant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/secundant/neodx.git",
    "directory": "libs/<%=name%>"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "exit 0 || tsc --noEmit",
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "nuke": "rm -rf dist",
    "pack": "vp pack"
  },
  "packageManager": "yarn@4.3.1"
}
