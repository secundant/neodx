{
  "name": "@neodx/e2e-svg",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@neodx/svg": "workspace:^",
    "@playwright/test": "1.52.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.19",
    "playwright": "^1.43.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vite-tsconfig-paths": "6.1.1"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/public/sprites"
        ],
        "inputs": [
          "{projectRoot}/src/assets/**/*.svg",
          "shared"
        ],
        "dependsOn": [
          "^build"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
